# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# generated local secrets, never commit
.admin_credentials_LOCAL.txt

# datos personales reales del club (cédulas, fechas de nacimiento de
# menores) y scripts de carga con la contraseña compartida en texto plano --
# nunca a git, ni siquiera en un repo privado
/Documentos WD/
scripts/import-deportistas.mjs
scripts/import-fixups.mjs

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
